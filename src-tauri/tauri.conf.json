{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Web Desktop",
  "version": "0.12.0",
  "identifier": "com.earendil.pi-web",
  "build": {
    "beforeDevCommand": "npm run --prefix ../src-app dev",
    "devUrl": "http://127.0.0.1:30141",
    "beforeBuildCommand": "",
    "frontendDist": "./loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "../app": "app"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installMode": "currentUser",
        "startMenuFolder": "Pi Web"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Jiaocha/pi-web-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_SIGNER_PUBKEY",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
